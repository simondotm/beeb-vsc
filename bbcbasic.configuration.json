{
  "comments": {
    "lineComment": "REM"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["[", "]"],
    ["(", ")"],
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "&[0-9A-Fa-f]+|[A-Za-z_`@][A-Za-z0-9_`]*[$%]?|\\d+(?:\\.\\d+)?(?:E[-+]?\\d+)?"
}
